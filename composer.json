{
	"name": "belisoful/prado-websocket",
	"type": "prado4-extension",
	"description": "WebSocket server and client for the PRADO PHP framework: RFC 6455 over HTTP/1.1, with HTTP/2 (RFC 8441) via nghttp2.",
	"keywords": [ "prado", "framework", "websocket", "rfc6455", "rfc8441", "http2", "nghttp2", "extension"],
	"homepage": "https://github.com/belisoful/prado-websocket",
	"license": "BSD-3-Clause",
	"authors": [
		{
			"name": "Brad Anderson",
			"email": "belisoful@icloud.com",
			"role": "Developer",
			"homepage": "https://github.com/belisoful"
		}
	],
	"autoload": {
		"psr-4": {
			"Prado\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Prado\\Test\\Unit\\": "tests/unit/"
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://asset-packagist.org"
		}
	],
	"prefer-stable": true,
	"require": {
		"php": ">=8.1.0",
		"pradosoft/prado": "^4.4@dev"
	},
	"suggest": {
		"ext-openssl": "TLS with ALPN for wss:// and HTTP/2 over TLS (h2).",
		"ext-sockets": "Faster socket primitives for the standalone server.",
		"ext-zlib": "RFC 7692 permessage-deflate message compression (TPermessageDeflateExtension).",
		"ext-redis": "Redis-backed cluster backplane (TRedisBackplane) for multi-host scaling.",
		"lib-nghttp2": "The system libnghttp2 shared library, used by belisoful/prado-http2 for HTTP/2.",
		"ext-ffi": "Required by belisoful/prado-http2 to bind libnghttp2 for HTTP/2.",
		"belisoful/prado-http2": "HTTP/2 (RFC 8441) WebSocket multiplexing; without it the server serves HTTP/1.1 only."
	},
	"require-dev": {
		"belisoful/prado-http2": "^1.0",
		"phpunit/phpunit": "^10",
		"phpdocumentor/shim": "^3",
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpstan/phpstan": "^2.1"
	},
	"config": {
		"platform": {
			"php": "8.1"
		},
		"allow-plugins": {
			"phpdocumentor/shim": true
		}
	},
	"scripts": {
		"fix": [
			"vendor/bin/php-cs-fixer fix src",
			"vendor/bin/php-cs-fixer fix tests"
		],
		"stan": "vendor/bin/phpstan analyse --memory-limit=1G",
		"unittest": "vendor/bin/phpunit --testsuite unit",
		"coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"vendor/bin/phpunit --testsuite unit --coverage-text"
		],
		"coverage-html": [
			"@putenv XDEBUG_MODE=coverage",
			"vendor/bin/phpunit --testsuite unit --coverage-html build/coverage"
		],
		"fulltest": [
			"@fix",
			"@stan",
			"@unittest"
		],
		"functest": [
			"Composer\\Config::disableProcessTimeout",
			"npx playwright test --project=chromium"
		],
		"functionaltest": [
			"Composer\\Config::disableProcessTimeout",
			"npx playwright test"
		]
	},
	"extra": {
		"prado": {
			"error-messages": "config/errorMessages.txt",
			"class-map": "config/classMap.json"
		}
	}
}
