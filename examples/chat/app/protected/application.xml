<?xml version="1.0" encoding="utf-8"?>
<!--
	The chat example's PRADO configuration.

	Web:        php -S 127.0.0.1:8089 -t examples/chat/app
	WebSocket:  vendor/bin/prado-cli -d examples/chat/app/protected websocket/serve
-->
<application id="prado-chat" Mode="Debug">
	<!--
		Only for running the example inside the prado-websocket checkout. An application that
		installs belisoful/prado-websocket through Composer gets these messages automatically.
	-->
	<errorMessage file="../../../../config/errorMessages.txt" />

	<modules>
		<!-- The module hands its cluster to ChatHandler and re-raises its events. -->
		<module id="websockets" class="Prado\IO\Socket\WebSocket\TWebSocketModule"
			Address="127.0.0.1" Port="8090" IdleTimeout="60"
			Subprotocols="prado.pubsub.v1"
			HandlerClass="Application\ChatHandler" />
	</modules>

	<services>
		<service id="page" class="Prado\Web\Services\TPageService" DefaultPage="Home" />
	</services>
</application>
